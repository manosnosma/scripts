#!/usr/bin/env bash
set -euo pipefail

DIRS=(
	"$HOME/Projects/apps"
	"$HOME/Projects"
	"$HOME/.config/"
	"$HOME/.local/bin/scripts"
	"$HOME/.local/bin"
	"$HOME/Documents/Brain"
	"$HOME/Documents/archives"
	"$HOME/Documents"
	"$HOME/Pictures/screenshots"
	"$HOME/Pictures"
)

tmux_run() {
	local target="$1"

	if [[ $target == rws ]]; then
		exec tmux-rws
	fi

	if [[ -n "${TMUX:-}" ]]; then
		tmux switch-client -t "$target"
	else
		tmux attach -t "$target"
	fi
}

session_name_from_line() {
	local line="${1%%$'\n'*}"
	line="${line%"${line##*[![:space:]]}"}"
	[[ $line =~ ^(\[[0-9]+\])?\[s\]\ ([^[:space:]]+)$ ]] || return 1
	printf '%s' "${BASH_REMATCH[2]}"
}

attach_or_create() {
	local path="$1"
	local name
	name=$(basename "$path" | tr . _)

	if [[ $name == rws ]]; then
		exec tmux-rws
	fi

	if ! tmux has-session -t "$name" 2>/dev/null; then
		tmux new-session -ds "$name" -c "$path"
	fi

	tmux_run "$name"
}

# Direct path argument (anything except a lone digit 1-9)
if [[ $# -eq 1 && ! $1 =~ ^[1-9]$ ]]; then
	attach_or_create "$1"
	exit 0
fi

current=""
[[ -n "${TMUX:-}" ]] && current=$(tmux display-message -p '#S' 2>/dev/null || true)

tmux_sessions=$(
	tmux list-sessions -F '#{session_last_attached} #{session_name}' 2>/dev/null | sort -rn || true
)

# Numeric shortcut: tmux-sessionizer 3 → 3rd most recent session (excluding current)
if [[ $# -eq 1 && $1 =~ ^[1-9]$ ]]; then
	idx=$1
	name=$(
		export TS_SESSIONS="$tmux_sessions" TS_CUR="$current"
		awk -v n="$idx" 'BEGIN {
			cur = ENVIRON["TS_CUR"]
			split(ENVIRON["TS_SESSIONS"], lines, "\n")
			i = 0
			for (k = 1; k <= length(lines); k++) {
				if (lines[k] == "") continue
				p = index(lines[k], " ")
				if (p == 0) continue
				name = substr(lines[k], p + 1)
				gsub(/^[ \t]+|[ \t]+$/, "", name)
				if (name == "" || name == cur) continue
				i++
				if (i == n) { print name; exit }
			}
		}' </dev/null
	)
	[[ -n $name ]] || exit 1
	tmux_run "$name"
	exit 0
fi

export TS_SESSIONS="$tmux_sessions"
export TS_CUR="$current"
export TS_HOME="$HOME/"

session_slots=$(
	awk 'BEGIN {
		cur = ENVIRON["TS_CUR"]
		n = split(ENVIRON["TS_SESSIONS"], lines, "\n")
		for (i = 1; i <= n; i++) {
			if (lines[i] == "") continue
			p = index(lines[i], " ")
			if (p == 0) continue
			name = substr(lines[i], p + 1)
			gsub(/^[ \t]+|[ \t]+$/, "", name)
			if (name == "" || name == cur) continue
			print name
		}
	}' </dev/null | wc -l | tr -d ' '
)

menu=$(
	{
		awk 'BEGIN {
			cur = ENVIRON["TS_CUR"]
			n = split(ENVIRON["TS_SESSIONS"], lines, "\n")
			slot = 0
			for (i = 1; i <= n; i++) {
				if (lines[i] == "") continue
				p = index(lines[i], " ")
				if (p == 0) continue
				name = substr(lines[i], p + 1)
				gsub(/^[ \t]+|[ \t]+$/, "", name)
				if (name == "" || name == cur) continue
				slot++
				if (slot <= 9)
					printf "[%d][s] %s\n", slot, name
				else
					printf "[s] %s\n", name
			}
		}' </dev/null

		fd . "${DIRS[@]}" --type=dir --max-depth=1 --full-path | awk '
			BEGIN {
				n = split(ENVIRON["TS_SESSIONS"], lines, "\n")
				for (i = 1; i <= n; i++) {
					if (lines[i] == "") continue
					p = index(lines[i], " ")
					if (p > 0) {
						name = substr(lines[i], p + 1)
						gsub(/^[ \t]+|[ \t]+$/, "", name)
						if (name != "") existing[name] = 1
					}
				}
				home = ENVIRON["TS_HOME"]
				hlen = length(home)
			}
			{
				path = $0
				stripped = path
				sub(/\/+$/, "", stripped)
				k = split(stripped, parts, "/")
				name = parts[k]
				gsub(/\./, "_", name)
				if (name in existing) next
				if (substr(path, 1, hlen) == home) path = substr(path, hlen + 1)
				print path
			}
		'
	}
)

sk_header="tmux-sessionizer"
[[ -n $current ]] && sk_header+=" · current: ${current}"
sk_header+=$'\n'"1-9 switch session · type to filter · enter opens dir"

sk_binds='enter:accept'
while IFS= read -r bind; do
	[[ -n $bind ]] && sk_binds+=",$bind"
done < <(
	awk 'BEGIN {
		cur = ENVIRON["TS_CUR"]
		n = split(ENVIRON["TS_SESSIONS"], lines, "\n")
		slot = 0
		for (i = 1; i <= n; i++) {
			if (lines[i] == "") continue
			p = index(lines[i], " ")
			if (p == 0) continue
			name = substr(lines[i], p + 1)
			gsub(/^[ \t]+|[ \t]+$/, "", name)
			if (name == "" || name == cur) continue
			slot++
			if (slot > 9) break
			line = sprintf("[%d][s] %s", slot, name)
			gsub(/\\/, "\\\\", line)
			printf "%d:if-query-empty:accept(%s)\n", slot, line
		}
	}' </dev/null
)

selected=$(
	printf '%s\n' "$menu" | sk \
		--margin 10% \
		--color=dark \
		--header "$sk_header" \
		--prompt 'session> ' \
		--bind "$sk_binds" | head -n1
) || exit 1

selected="${selected%%$'\n'*}"
selected="${selected//$'\r'/}"

[[ -z $selected ]] && exit 1

if session_name=$(session_name_from_line "$selected"); then
	tmux_run "$session_name"
	exit 0
fi

attach_or_create "$HOME/$selected"
