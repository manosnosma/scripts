#!/usr/bin/env bash

DIRS=(
	"$HOME/Projects/apps"
	"$HOME/Projects"
	"$HOME/.config/"
	"$HOME/.local/bin/scripts"
	"$HOME/.local/bin"
	"$HOME/Documents/Brain"
	"$HOME/Documents/archives"
	"$HOME/Documents"
	"$HOME/Pictures/screenshots"
	"$HOME/Pictures"
)

tmux_run() {
  local target="$1"

  if [[ -n "$TMUX" ]]; then
    tmux switch-client -t "$target"
  else
    tmux attach -t "$target"
  fi
}

if [[ $# -eq 1 ]]; then
	selected=$1
else
	current=""
	[[ -n "$TMUX" ]] && current=$(tmux display-message -p '#S' 2>/dev/null)

	tmux_sessions=$(tmux list-sessions -F '#{session_last_attached} #{session_name}' 2>/dev/null | sort -rn)

	export TS_SESSIONS="$tmux_sessions"
	export TS_CUR="$current"
	export TS_HOME="$HOME/"

	selected=$(
		{
			awk 'BEGIN {
				cur = ENVIRON["TS_CUR"]
				n = split(ENVIRON["TS_SESSIONS"], lines, "\n")
				for (i = 1; i <= n; i++) {
					p = index(lines[i], " ")
					if (p > 0) {
						name = substr(lines[i], p+1)
						if (name != cur) print "[s] " name
					}
				}
			}' </dev/null

			fd . "${DIRS[@]}" --type=dir --max-depth=1 --full-path | \
				awk '
					BEGIN {
						n = split(ENVIRON["TS_SESSIONS"], lines, "\n")
						for (i = 1; i <= n; i++) {
							p = index(lines[i], " ")
							if (p > 0) existing[substr(lines[i], p+1)] = 1
						}
						home = ENVIRON["TS_HOME"]
						hlen = length(home)
					}
					{
						path = $0
						stripped = path
						sub(/\/+$/, "", stripped)
						k = split(stripped, parts, "/")
						name = parts[k]
						gsub(/\./, "_", name)
						if (name in existing) next
						if (substr(path, 1, hlen) == home) path = substr(path, hlen + 1)
						print path
					}
				'
		} | sk --margin 10% --color="bw"
	)

	if [[ $selected == "[s] "* ]]; then
		tmux_run "${selected#\[s\] }"
		exit 0
	fi

	[[ $selected ]] && selected="$HOME/$selected"
fi

[[ ! $selected ]] && exit 1

selected_name=$(basename "$selected" | tr . _)

# Special case: rws is always built by tmux-rws
if [[ "$selected_name" == "rws" ]]; then
  exec tmux-rws
fi

# Generic sessions
if ! tmux has-session -t "$selected_name" 2>/dev/null; then
  tmux new-session -ds "$selected_name" -c "$selected"
fi

tmux_run "$selected_name"
