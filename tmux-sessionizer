#!/usr/bin/env bash

DIRS=(
	"$HOME/Projects/apps"
	"$HOME/Projects"
	"$HOME/.config/"
	"$HOME/.local/bin/scripts"
	"$HOME/.local/bin"
	"$HOME/Documents/Brain"
	"$HOME/Documents/archives"
	"$HOME/Documents"
	"$HOME/Pictures/screenshots"
	"$HOME/Pictures"
)

tmux_run() {
  local target="$1"

  if [[ -n "$TMUX" ]]; then
    tmux switch-client -t "$target"
  else
    tmux attach -t "$target"
  fi
}

if [[ $# -eq 1 ]]; then
	selected=$1
else
	sessions=$(tmux ls 2>/dev/null | awk -F: '{print "[s] " $1}')
	dirs=$(fd . "${DIRS[@]}" --type=dir --max-depth=1 --full-path | sed "s|^$HOME/||")
	selected=$(printf '%s\n%s\n' "$sessions" "$dirs" | sed '/^$/d' | sk --margin 10% --color="bw")

	if [[ $selected == "[s] "* ]]; then
		tmux_run "${selected#\[s\] }"
		exit 0
	fi

	[[ $selected ]] && selected="$HOME/$selected"
fi

[[ ! $selected ]] && exit 1

selected_name=$(basename "$selected" | tr . _)

# Special case: rws is always built by tmux-rws
if [[ "$selected_name" == "rws" ]]; then
  exec tmux-rws
fi

# Generic sessions
if ! tmux has-session -t "$selected_name" 2>/dev/null; then
  tmux new-session -ds "$selected_name" -c "$selected"
fi

tmux_run "$selected_name"
