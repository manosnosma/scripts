#!/usr/bin/env bash
set -euo pipefail

if [ $# -lt 1 ] || [ -z "$1" ]; then
    exit 0
fi

name=$(basename "$1")
clean_name=$(echo "$name" | tr "./" "__")
session=$(tmux display-message -p "#S")
target="${session}:${clean_name}"

if ! tmux list-windows -t "$session" -F '#W' | grep -qx "$clean_name"; then
    tmux neww -dn "$clean_name" -t "$session"
fi

shift
if [ $# -gt 0 ] && [ -n "$*" ]; then
    tmux send-keys -t "$target" "$*" Enter
fi

tmux select-window -t "$target"
